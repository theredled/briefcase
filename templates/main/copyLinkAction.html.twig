{% set url = action is defined ? action.getLinkUrl() : url %}

    <p class="copy-url-success-message hidden">Lien copié !</p>

    <a href="{{ url }}" class="btn copy-url-btn btn-secondary" data-url="{{ absolute_url(url) }}">
        <i class="fa fa-copy"></i> <span class="btn-label">Copier le lien</span>
    </a>
